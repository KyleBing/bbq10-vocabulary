<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="right|center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/chkLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:minHeight="0dp"
            android:text="@string/live_spell"
            android:textColor="@color/text"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/chkIme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="@string/ime_suggest"
            android:textColor="@color/text"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="left|top"
                android:textColor="@color/word"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/blankSentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="left|top"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/blankCn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="left|top"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Typed input + confirm result share one centered stack -->
    <LinearLayout
        android:id="@+id/typedStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/typedPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="28dp"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/word"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_panel"
        android:gravity="center"
        android:hint="@string/hint_spell"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="textVisiblePassword|textNoSuggestions"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/word"
        android:textColorHint="@color/text_dim"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_next"
        android:text="@string/btn_view_result"
        android:textColor="@color/word"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/resultBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnStash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_stash"
            android:text="@string/btn_stash"
            android:textColor="@color/stash_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_next"
            android:text="@string/btn_next"
            android:textColor="@color/word"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
