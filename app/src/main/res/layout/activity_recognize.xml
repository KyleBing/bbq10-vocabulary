<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/word"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/phonetic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/stashBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@color/stash"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/badge_stash"
        android:textColor="@color/stash_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/meaningScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|top"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/exampleEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="left|top"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/exampleCn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="left|top"
                android:textColor="@color/text_dim"
                android:textSize="16sp"
                android:visibility="invisible" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/markBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUnknown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@color/unknown"
            android:text="@string/btn_unknown"
            android:textColor="@color/word"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnKnow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@color/know"
            android:text="@string/btn_know"
            android:textColor="@color/word"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnStash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@color/stash"
            android:text="@string/btn_stash"
            android:textColor="@color/stash_text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@color/next"
            android:text="@string/btn_next"
            android:textColor="@color/word"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
