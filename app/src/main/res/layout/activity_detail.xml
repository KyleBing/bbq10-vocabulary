<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/wordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/word"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/phonetic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSpeak"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_next"
        android:minWidth="72dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/btn_speak"
        android:textColor="@color/word"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/stashBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="@drawable/btn_stash"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/badge_stash"
        android:textColor="@color/stash_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left|top"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/exampleEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="left|top"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/exampleCn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="left|top"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUnknown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/btn_unknown"
            android:text="@string/btn_unknown"
            android:textColor="@color/word"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnStash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/btn_stash"
            android:text="@string/btn_stash"
            android:textColor="@color/stash_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnKnow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:background="@drawable/btn_know"
            android:text="@string/btn_know"
            android:textColor="@color/word"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
