<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/word"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_speak_section"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/chkAutoSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_auto_speak"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/speakWhenLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/settings_speak_when"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/speakWhenGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioSpeakBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_speak_before"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radioSpeakAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_speak_after"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chkSpeakExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_speak_example"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_speak_hint"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
